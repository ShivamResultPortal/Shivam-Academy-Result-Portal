# Server Configuration
PORT=3000
NODE_ENV=development

# Railway PostgreSQL Connection URL
# On Railway, this is automatically provided as ${{Postgres.DATABASE_URL}}
# Example: postgresql://postgres:password@roundhouse.proxy.rlwy.net:5432/railway
DATABASE_URL=postgresql://postgres:password@localhost:5432/shivam_academy_db

# Security & CORS
JWT_SECRET=shivam_academy_super_secret_jwt_key_2026_change_in_production
# Comma-separated list of allowed origins (e.g., your Vercel URL and localhost)
CORS_ORIGIN=http://localhost:8080,https://shivam-academy-result-portal.vercel.app

# Default Admin Seed Credentials (used by seed script)
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123
